{
  "name": "rms-discord",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev:web": "pnpm --filter @rms-discord/web dev",
    "build:web": "pnpm --filter @rms-discord/web build",
    "build:desktop": "pnpm --filter @rms-discord/desktop build",
    "desktop:dev": "pnpm -C apps/desktop exec tauri dev",
    "desktop:build": "pnpm -C apps/desktop exec tauri build",
    "test:ui-style": "node scripts/check-zhimo-theme.mjs"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@tauri-apps/cli": "^2",
    "rollup": "^4.60.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "vue-draggable-plus": "^0.6.1"
  }
}
